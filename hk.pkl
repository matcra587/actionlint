amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

min_hk_version = "2.0.1"

local projectStep = new Step {
    check = new CommandSpec {
        effect = "write"
    }
}

// Build first, then overlap independent checks. Go coordinates its own caches;
// none of these checks rewrites source files or the actionlint binary.
local projectChecks = new Mapping<String, Step> {
    ["build"] = (projectStep) {
        exclusive = true
        check { command = "mise run build" }
    }
    ["test"] = (projectStep) {
        depends = "build"
        check { command = "mise run test" }
    }
    ["lint"] = (projectStep) {
        depends = "build"
        check { command = "mise run lint" }
    }
    ["workflows"] = (projectStep) {
        depends = "build"
        // The build step already produced the binary for this hook invocation.
        check { command = "mise run --skip-deps workflows" }
    }
}

hooks {
    ["pre-commit"] {
        fix = false
        stage = false
        stash = "git"
        steps {
            ["rumdl"] = (projectStep) {
                glob = List("**/*.md", "**/*.markdown", "rumdl.toml", "hk.pkl", ".mise/tasks/tasks.toml", "mise.lock")
                exclude = List("**/testdata/**", "CHANGELOG.md")
                // Check all documents so config edits also validate unchanged Markdown.
                check { command = "mise run lint:markdown" }
            }
        }
    }
    ["pre-push"] {
        stage = false
        steps {
            for (name, step in projectChecks) {
                [name] = (step) {
                    step_condition = "env('CI') == ''"
                }
            }
        }
    }
    ["check"] {
        stage = false
        steps = projectChecks
    }
}
