#!/usr/bin/env bash
#MISE description="Validate and tag a prepared release on pushed main"
#MISE dir="{{config_root}}"
#MISE alias="release"
#USAGE flag "--dry-run" help="Run preflight without creating or pushing a tag"
#USAGE arg "<version>" help="Prepared stable version, such as 1.9.0"

set -euo pipefail

# shellcheck source=scripts/release/version.bash
source "${BASH_SOURCE[0]%/*}/../../../scripts/release/version.bash"

fail() {
    echo "Release refused: $*" >&2
    exit 1
}

tag="v${usage_version:?Use mise run release --help}"
version="$(release_version "$tag")" || fail 'invalid version'

[[ "$(git branch --show-current)" == main ]] || fail 'run from main'
[[ -z "$(git status --porcelain)" ]] || fail 'working tree must be clean'
[[ "$(cat VERSION)" == "$version" ]] || fail 'prepare VERSION in a pull request first'
[[ -s ".changes/${tag}.md" ]] || fail "release notes .changes/${tag}.md are missing or empty"

git fetch --tags origin refs/heads/main:refs/remotes/origin/main
target="$(git rev-parse HEAD)"
[[ "$target" == "$(git rev-parse origin/main)" ]] || fail 'main must match pushed origin/main'
if git show-ref --verify --quiet "refs/tags/${tag}"; then
    fail "tag ${tag} already exists"
fi

mise run release:preflight

# Preflight must not silently change the commit or source being tagged.
[[ -z "$(git status --porcelain)" ]] || fail 'preflight changed the working tree'
[[ "$target" == "$(git rev-parse HEAD)" ]] || fail 'preflight changed HEAD'

if [[ "${usage_dry_run:-false}" == true ]]; then
    echo "Dry run: would create annotated tag ${tag} at ${target} and push the tag to origin"
    exit 0
fi

git tag -a "$tag" "$target" -m "$tag"
git push origin "refs/tags/${tag}"
echo "Pushed ${tag}; the release workflow will wait for CI and security checks before publishing"
