{
  "name": "actionlint-playground",
  "private": true,
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "lint:tsc": "tsc -p .",
    "lint": "biome ci . && bun run lint:tsc",
    "build": "bun run lint:tsc && bun build ./index.html --outdir dist --sourcemap=linked --entry-naming \"[name].[ext]\" --chunk-naming \"assets/[name]-[hash].[ext]\" --asset-naming \"assets/[name]-[hash].[ext]\"",
    "watch": "bun run build --watch",
    "serve": "http-server dist -p 1234",
    "start": "bun run serve",
    "test": "bun test",
    "format": "biome format --write ."
  },
  "author": "rhysd <lin90162@yahoo.co.jp> (https://rhysd.github.io/)",
  "license": "MIT",
  "dependencies": {
    "bulma": "^1.0.4",
    "codemirror": "^5.65.8",
    "devicon": "^2.17.0",
    "ismobilejs": "^1.1.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/codemirror": "^5.60.17",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3"
  }
}
